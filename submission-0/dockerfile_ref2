# ViTacFormer Policy Server for Origami Competition
# Multi-stage Docker build for minimal runtime image

# =============================================================================
# Stage 1: Build dependencies
# =============================================================================
FROM python:3.10-slim as builder

WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy and install Python dependencies
COPY requirements.lock /build/requirements.lock
RUN pip install --no-cache-dir --prefix=/install -r /build/requirements.lock

# =============================================================================
# Stage 2: Runtime image
# =============================================================================
FROM nvidia/cuda:12.1.0-cudnn8-runtime-ubuntu22.04

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/tmp/vitac \
    XDG_CACHE_HOME=/tmp/vitac-cache

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/bin/python

# Create non-root user (UID 65532 = nobody)
RUN useradd -m -u 65532 vitac

WORKDIR /app

# Copy installed packages from builder
COPY --from=builder --chown=vitac:vitac /install /usr/local

# Copy ViTacFormer policy code
COPY --chown=vitac:vitac vitac_policy/ /app/vitac_policy/
COPY --chown=vitac:vitac policy_server.py /app/policy_server.py
COPY --chown=vitac:vitac entrypoint.sh /app/entrypoint.sh

# Copy checkpoints and assets (create directories if empty)
COPY --chown=vitac:vitac assets/ /opt/vitacformer/assets/
COPY --chown=vitac:vitac checkpoints/ /opt/vitacformer/checkpoints/

# Copy licenses
COPY --chown=vitac:vitac licenses/ /licenses/ 2>/dev/null || true

# Set permissions
RUN chmod 0755 /app/entrypoint.sh \
    && chmod -R a+rX /app /opt/vitacformer /licenses 2>/dev/null || true \
    && chmod -R 777 /tmp 2>/dev/null || true

# Switch to non-root user
USER 65532:65532

# Health check (none - readiness is via metadata query)
HEALTHCHECK NONE

# Set entrypoint
ENTRYPOINT ["/app/entrypoint.sh"]
