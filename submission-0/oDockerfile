# ---------------------------------------------------------------------------
# Stage 2: runtime -- minimal, nonroot, no build tools
# ---------------------------------------------------------------------------
FROM python:3.11-slim AS runtime


# Install system libraries required by OpenCV, NumPy, and PyTorch C-extensions
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*


    
COPY --from=builder /.venv /.venv
ENV PATH="/.venv/bin:${PATH}"

WORKDIR /app

# vitacformer inference-only source (no dataset/, no lerobot dependency).
COPY vitacformer/policy.py       /app/vitacformer/policy.py
COPY vitacformer/detr            /app/vitacformer/detr
COPY vitacformer/train_utils.py  /app/vitacformer/train_utils.py
COPY vitacformer/configs.py      /app/vitacformer/configs.py

COPY vitac_policy    /app/vitac_policy

# Checkpoint baked into the image (read-only at runtime).
COPY checkpoints/policy_epoch_30_loss_0.041.ckpt /app/checkpoints/policy_best.ckpt

# The completed protocol adapter from earlier in this thread.
COPY policy_server.py /app/policy_server.py

ENV PYTHONPATH="/app:/app/vitacformer:${PATH}" \
    VITACFORMER_ROOT=/app/vitacformer \
    VITAC_CKPT_PATH=/app/checkpoints/policy_best.ckpt \
    ORIGAMI_ACTION_HORIZON=25 \
    HOME=/tmp/origami-home \
    XDG_CACHE_HOME=/tmp/origami-cache \
    IPYTHONDIR=/tmp/origami-ipython \
    MPLCONFIGDIR=/tmp/origami-mpl

# Pre-create writable-cache dirs so the image also works when run WITHOUT the evaluator's
# tmpfs mounts (e.g. a plain `docker run`); under the evaluator's --read-only + tmpfs /tmp,
# these paths are shadowed by the tmpfs mount at runtime anyway.
RUN mkdir -p /tmp/origami-home /tmp/origami-cache /tmp/origami-ipython /tmp/origami-mpl \
    && chown -R 65532:65532 /app /tmp/origami-home /tmp/origami-cache /tmp/origami-ipython /tmp/origami-mpl

# Matches the --user 65532:65532 the local evaluator forces via `docker run` regardless
# (docker_runtime.py's _policy_command); set here too so the image is correct standalone.
USER 65532:65532

HEALTHCHECK NONE

ENTRYPOINT ["/app/entrypoint.sh"]




