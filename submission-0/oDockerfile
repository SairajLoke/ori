# ViTacFormer Policy Server for Origami Competition
# Multi-stage Docker build for minimal runtime CPU image

# =============================================================================
# Stage 1: Build dependencies
# =============================================================================
FROM python:3.11-slim AS builder

ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

RUN python -m venv /.venv
ENV PATH="/.venv/bin:${PATH}"

# torch/torchvision need the special --index-url, so installed separately from the rest.
RUN pip install \
    --default-timeout=20 \
    --retries=5 \
    --index-url "${TORCH_INDEX_URL}" \
    --extra-index-url https://pypi.org/simple \
    torch torchvision msgpack msgpack-numpy


    # --no-cache-dir \

# Everything else comes from requirements-inference.txt (from earlier in this thread) --
# referenced here, not retyped, so the two files can't drift out of sync. Expected in the
# build context alongside this Dockerfile.
COPY requirements-inference.txt /tmp/requirements-inference.txt
RUN pip install -r /tmp/requirements-inference.txt \
 && rm /tmp/requirements-inference.txt
#  --no-cache-dir

COPY vitacformer/detr       /app/vitacformer/detr
RUN pip install -e /app/vitacformer/detr

